PREFIX=.
# Optional: free key from console.groq.com makes .ai / .char smarter (falls back to a free AI without it)
GROQ_API_KEY=
# Your number with country code, no + (gives a pairing code in the logs instead of a QR)
PAIRING_NUMBER=2348101234567
# Secret for https://your-domain.example/qr?key=THIS
QR_KEY=change_me
# Comma-separated owner numbers
OWNER_NUMBER=2348101234567
# Persistent folder (host folder kept between restarts; docker-compose maps ./data)
DATA_DIR=/var/data
# Public address of the site, shown by .weblogin and .profile
PUBLIC_URL=https://your-domain.example

# Optional: if .play says it could not get a song, YouTube is blocking the server. Export your YouTube cookies
# (Netscape format, from a throwaway account) with a browser extension, then paste the text or its base64 here.
YT_COOKIES=

# ---- Neon (free Postgres) backup: keeps the WhatsApp login + player data across redeploys. See NEON.md
# Paste the connection string from the Neon dashboard (Connect). Leave empty to turn the backup off.
NEON_DATABASE_URL=
NEON_SYNC_SECONDS=15

# ---- Continue with Google (see GOOGLE.md). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: run the Discord edition inside this same service (shares the one disk and database) ---
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_OWNER_IDS=
